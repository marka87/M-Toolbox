{
  "name": "m-toolbox",
  "version": "1.9.4",
  "description": "Modern Windows 11 system utility suite for maintenance, diagnostics, repair and optimization",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:setup": "tsc && vite build && electron-builder --win nsis",
    "build:portable": "tsc && vite build && electron-builder --win portable",
    "build:renderer": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "windows",
    "utility",
    "toolbox",
    "system",
    "electron",
    "windows-11",
    "maintenance",
    "diagnostics",
    "winget"
  ],
  "author": "Mark Angyal",
  "license": "MIT",
  "homepage": "https://github.com/marka87/M-Toolbox#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/marka87/M-Toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/marka87/M-Toolbox/issues"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
